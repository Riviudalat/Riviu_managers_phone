+#[derive(Debug)]
+struct GroundedVerification {
+    relevance: u8,
+    evidence_support: u8,
+    instruction_fit: u8,
+    genericity: u8,
+    contradiction: bool,
+    unsupported_claim: bool,
+    ui_text_confusion: bool,
+    prompt_tokens: u32,
+    completion_tokens: u32,
+    model: String,
