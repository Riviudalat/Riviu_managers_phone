+        if (self.watch_min, self.watch_max) == (5.0, 20.0) {
+            self.watch_min = defaults.watch_min;
+            self.watch_max = defaults.watch_max;
+            changed = true;
+        }
+        replace_if!(schedule_every_minutes, 60);
+        replace_if!(schedule_duration_minutes, 20);
