+                + (dark - 0.65).min(0.25) * 0.15
+                + (cross - 0.04).min(0.15) * 0.20
+                + (warm - 0.10).min(0.50) * 0.05)
+                .min(0.99);
+            if best.is_none_or(|(_, _, old)| score > old) {
+                best = Some((cx as f64 / w as f64, cy as f64 / h as f64, score));
+            }
+        }
+    }
+    best
+}
