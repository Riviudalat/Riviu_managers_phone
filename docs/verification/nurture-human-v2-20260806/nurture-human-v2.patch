+        tokio::time::sleep(Duration::from_millis(1200)).await;
+        Ok::<(), anyhow::Error>(())
+    }
+    .await;
+    let cleanup = control.close_ui_context(stream).await;
+    result?;
+    cleanup?;
+    Ok(())
