+}
+
++ (id<FBResponsePayload>)riviuMediaPrepareResponseForCampaign:(NSString *)campaignId
+                                                  manifestSha256:(NSString *)expectedManifestSha256
+{
+  if (![self riviuMediaSafeComponent:campaignId] || ![self riviuMediaSha256:expectedManifestSha256]) {
+    return [self riviuMediaInvalid:@"campaignId or manifestSha256 does not match media-v1"];
+  }
+
+  NSString *root = [self riviuMediaRootForCampaign:campaignId];
+  NSString *manifestPath = [root stringByAppendingPathComponent:@"manifest.json"];
+  NSData *manifestData = [NSData dataWithContentsOfFile:manifestPath options:NSDataReadingMappedIfSafe error:nil];
+  if (nil == manifestData) {
+    return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:@"media manifest is missing" traceback:nil]);
+  }
+  if (![[self riviuMediaSha256Hex:manifestData] isEqualToString:expectedManifestSha256]) {
+    return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:@"media manifest hash mismatch" traceback:nil]);
+  }
+
+  NSError *jsonError = nil;
+  id decoded = [NSJSONSerialization JSONObjectWithData:manifestData options:0 error:&jsonError];
+  if (![decoded isKindOfClass:NSDictionary.class]) {
+    return [self riviuMediaInvalid:@"media manifest must be a JSON object"];
+  }
+  NSDictionary *manifest = (NSDictionary *)decoded;
+  if (![manifest[@"campaignId"] isEqual:campaignId] || [manifest[@"schemaVersion"] integerValue] != 1) {
+    return [self riviuMediaInvalid:@"media manifest identity is invalid"];
+  }
+  NSArray *files = manifest[@"files"];
+  if (![files isKindOfClass:NSArray.class] || files.count == 0) {
+    return [self riviuMediaInvalid:@"media manifest contains no files"];
+  }
+
+  NSMutableSet<NSString *> *seen = [NSMutableSet setWithCapacity:files.count];
+  for (id item in files) {
+    if (![item isKindOfClass:NSDictionary.class]) {
+      return [self riviuMediaInvalid:@"media manifest file entry is invalid"];
+    }
+    NSDictionary *entry = (NSDictionary *)item;
+    NSString *bundle = entry[@"bundle"];
+    NSString *file = entry[@"file"];
+    NSString *sha256 = entry[@"sha256"];
+    NSNumber *byteCount = entry[@"bytes"];
+    if (![self riviuMediaSafeComponent:bundle] || ![self riviuMediaSafeComponent:file] ||
+        ![self riviuMediaSha256:sha256] || ![byteCount isKindOfClass:NSNumber.class] || byteCount.longLongValue < 0) {
+      return [self riviuMediaInvalid:@"media manifest file entry schema is invalid"];
+    }
+    NSString *key = [NSString stringWithFormat:@"%@/%@", bundle, file];
+    if ([seen containsObject:key]) {
+      return [self riviuMediaInvalid:@"media manifest contains duplicate files"];
+    }
+    [seen addObject:key];
+    NSString *bundleRoot = [root stringByAppendingPathComponent:bundle];
+    NSString *filePath = [bundleRoot stringByAppendingPathComponent:file];
+    NSString *standardizedRoot = [root stringByAppendingString:@"/"];
+    if (![filePath.stringByStandardizingPath hasPrefix:standardizedRoot]) {
+      return [self riviuMediaInvalid:@"media manifest path escapes campaign root"];
+    }
+    NSData *fileData = [NSData dataWithContentsOfFile:filePath options:NSDataReadingMappedIfSafe error:nil];
+    if (nil == fileData || fileData.length != byteCount.unsignedLongLongValue ||
+        ![[self riviuMediaSha256Hex:fileData] isEqualToString:sha256]) {
+      return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:@"media file readback verification failed" traceback:nil]);
+    }
+  }
+
+  NSString *importId = [NSString stringWithFormat:@"%@-%@", campaignId, expectedManifestSha256];
+  return FBResponseWithObject(@{
+    @"campaignId": campaignId,
+    @"importId": importId,
+    @"state": @"ready",
+    @"files": @(files.count),
+  });
+}
+
++ (id<FBResponsePayload>)handleRiviuMediaPrepare:(FBRouteRequest *)request
+{
+  if (![request.arguments isKindOfClass:NSDictionary.class] || request.arguments.count != 2 ||
+      ![request.arguments[@"campaignId"] isKindOfClass:NSString.class] ||
+      ![request.arguments[@"manifestSha256"] isKindOfClass:NSString.class]) {
+    return [self riviuMediaInvalid:@"media prepare body must contain campaignId and manifestSha256 only"];
+  }
+  return [self riviuMediaPrepareResponseForCampaign:request.arguments[@"campaignId"]
+                                      manifestSha256:request.arguments[@"manifestSha256"]];
+}
+
++ (id<FBResponsePayload>)handleRiviuMediaStatus:(FBRouteRequest *)request
+{
+  NSString *importId = request.parameters[@"importId"];
+  if (![importId isKindOfClass:NSString.class] || importId.length <= CC_SHA256_DIGEST_LENGTH * 2 + 1) {
+    return [self riviuMediaInvalid:@"importId is invalid"];
+  }
+  NSUInteger separator = importId.length - (CC_SHA256_DIGEST_LENGTH * 2 + 1);
+  if ([importId characterAtIndex:separator] != '-') {
+    return [self riviuMediaInvalid:@"importId is invalid"];
+  }
+  NSString *campaignId = [importId substringToIndex:separator];
+  NSString *manifestSha256 = [importId substringFromIndex:separator + 1];
+  return [self riviuMediaPrepareResponseForCampaign:campaignId manifestSha256:manifestSha256];
+}
