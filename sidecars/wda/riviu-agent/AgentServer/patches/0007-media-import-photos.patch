+  NSString *albumId = [record[@"albumId"] isKindOfClass:NSString.class] ? record[@"albumId"] : nil;
+  PHFetchResult<PHAsset *> *assets = [PHAsset fetchAssetsWithLocalIdentifiers:assetIds options:nil];
+  PHFetchResult<PHAssetCollection *> *albums = albumId.length > 0
