+    }
+    if (albums.count > 0) {
+      [PHAssetCollectionChangeRequest deleteAssetCollections:albums];
+    }
+  } completionHandler:^(BOOL success, NSError *changeError) {
+    deleted = success;
+    changesError = changeError;
+    dispatch_semaphore_signal(changesSemaphore);
+  }];
