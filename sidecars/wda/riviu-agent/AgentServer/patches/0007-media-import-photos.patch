++ (BOOL)riviuMediaAuthorizeReadWrite:(NSError **)error
+{
+  PHAuthorizationStatus status;
+  if (@available(iOS 14.0, *)) {
+    status = [PHPhotoLibrary authorizationStatusForAccessLevel:PHAccessLevelReadWrite];
+  } else {
+    status = [PHPhotoLibrary authorizationStatus];
+  }
+  if (status == PHAuthorizationStatusAuthorized || status == PHAuthorizationStatusLimited) {
+    return YES;
+  }
+  if (status == PHAuthorizationStatusNotDetermined) {
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    __block PHAuthorizationStatus requested = PHAuthorizationStatusDenied;
+    if (@available(iOS 14.0, *)) {
+      [PHPhotoLibrary requestAuthorizationForAccessLevel:PHAccessLevelReadWrite handler:^(PHAuthorizationStatus result) {
+        requested = result;
+        dispatch_semaphore_signal(semaphore);
+      }];
+    } else {
+      [PHPhotoLibrary requestAuthorization:^(PHAuthorizationStatus result) {
+        requested = result;
+        dispatch_semaphore_signal(semaphore);
+      }];
+    }
+    NSDate *deadline = [NSDate dateWithTimeIntervalSinceNow:45.0];
+    while (dispatch_semaphore_wait(semaphore, DISPATCH_TIME_NOW) != 0) {
+      // The permission alert is hosted by SpringBoard.  Keep the XCTest run
+      // loop pumping while the request callback is pending; a blocking wait
+      // here prevents the callback from running when WDA handles the route on
+      // its main thread.  Dismiss the first-run prompt deterministically so a
+      // publish job does not remain in `transferring` waiting for a human tap.
+      @try {
+        XCUIElement *alert = XCUIApplication.fb_systemApplication.fb_alertElement;
+        if (alert != nil) {
+          NSPredicate *predicate = [NSPredicate predicateWithFormat:
+                                    @"label CONTAINS[c] %@ OR label CONTAINS[c] %@ OR label CONTAINS[c] %@",
+                                    @"tất cả ảnh", @"all photos", @"full access"];
+          XCUIElement *button = [[alert.buttons matchingPredicate:predicate]
+                                 firstMatch];
+          if (button.exists) {
+            [button tap];
+          }
+        }
+      } @catch (NSException *exception) {
+        // SpringBoard can disappear between the snapshot and tap. The next
+        // loop observes the authorization callback or a new prompt.
+      }
+      if ([[NSDate date] compare:deadline] != NSOrderedAscending) {
+        if (error != NULL) *error = [self riviuMediaError:@"photo library authorization timed out"];
+        return NO;
+      }
+      [[NSRunLoop currentRunLoop] runMode:NSDefaultRunLoopMode
+                               beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.10]];
+    }
+    status = requested;
+  }
+  if (status != PHAuthorizationStatusAuthorized && status != PHAuthorizationStatusLimited) {
+    if (error != NULL) *error = [self riviuMediaError:@"photo library read/write permission is required"];
+    return NO;
+  }
+  return YES;
+}
