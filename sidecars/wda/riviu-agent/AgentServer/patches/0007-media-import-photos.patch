+    @"campaignId": campaignId,
+    @"manifestSha256": manifestSha256,
+    @"albumId": albumId,
+    @"assetIds": assetIds,
+    @"files": @(imageFiles.count),
+  };
+  [[NSUserDefaults standardUserDefaults] setObject:record forKey:[self riviuMediaImportDefaultsKey:importId]];
+  [[NSUserDefaults standardUserDefaults] synchronize];
+  return FBResponseWithObject(@{
+    @"campaignId": campaignId,
+    @"importId": importId,
+    @"state": @"imported",
+    @"files": @(imageFiles.count),
+    @"albumId": albumId,
+  });
+}
