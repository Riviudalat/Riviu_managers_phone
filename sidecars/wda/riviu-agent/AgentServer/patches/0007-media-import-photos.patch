+    }
+    [[NSRunLoop currentRunLoop] runMode:NSDefaultRunLoopMode
+                             beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.10]];
+  }
+  if (!deleted) {
+    error = changesError;
+  }
+  if (!deleted) {
+    return FBResponseWithUnknownError(error ?: [self riviuMediaError:@"photo cleanup failed"]);
+  }
+  [[NSUserDefaults standardUserDefaults] removeObjectForKey:[self riviuMediaImportDefaultsKey:importId]];
+  [[NSUserDefaults standardUserDefaults] synchronize];
+  return FBResponseWithObject(@{
+    @"campaignId": campaignId,
+    @"importId": importId,
+    @"state": @"cleaned",
+    @"files": record[@"files"] ?: @0,
+  });
+}
