++ (id<FBResponsePayload>)handleRiviuMediaCleanup:(FBRouteRequest *)request
+{
+  NSString *importId = request.parameters[@"importId"];
+  NSString *campaignId = nil;
+  NSString *manifestSha256 = nil;
+  if (![self riviuMediaImportId:importId campaignId:&campaignId manifestSha256:&manifestSha256]) {
+    return [self riviuMediaInvalid:@"importId is invalid"];
+  }
+  NSDictionary *record = [[NSUserDefaults standardUserDefaults] objectForKey:[self riviuMediaImportDefaultsKey:importId]];
+  if (![record isKindOfClass:NSDictionary.class]) {
+    return FBResponseWithObject(@{
+      @"campaignId": campaignId,
+      @"importId": importId,
+      @"state": @"cleaned",
+      @"files": @0,
+    });
+  }
+  NSError *error = nil;
+  if (![self riviuMediaAuthorizeReadWrite:&error]) {
+    return FBResponseWithUnknownError(error ?: [self riviuMediaError:@"photo library authorization failed"]);
+  }
