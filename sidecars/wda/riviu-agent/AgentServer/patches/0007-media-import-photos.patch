++ (NSArray<NSDictionary *> *)riviuMediaImportFilesForCampaign:(NSString *)campaignId
+                                                  manifestSha256:(NSString *)expectedManifestSha256
+                                                           error:(NSError **)error
+{
+  if (![self riviuMediaSafeComponent:campaignId] || ![self riviuMediaSha256:expectedManifestSha256]) {
+    if (error != NULL) *error = [self riviuMediaError:@"campaignId or manifestSha256 does not match media-v1"];
+    return nil;
+  }
+  NSString *root = [self riviuMediaRootForCampaign:campaignId];
+  NSString *manifestPath = [root stringByAppendingPathComponent:@"manifest.json"];
+  NSData *manifestData = [NSData dataWithContentsOfFile:manifestPath options:NSDataReadingMappedIfSafe error:error];
+  if (manifestData == nil) {
+    if (error != NULL && *error == nil) *error = [self riviuMediaError:@"media manifest is missing"];
+    return nil;
+  }
+  if (![[self riviuMediaSha256Hex:manifestData] isEqualToString:expectedManifestSha256]) {
+    if (error != NULL) *error = [self riviuMediaError:@"media manifest hash mismatch"];
+    return nil;
+  }
+  NSError *jsonError = nil;
+  id decoded = [NSJSONSerialization JSONObjectWithData:manifestData options:0 error:&jsonError];
+  if (![decoded isKindOfClass:NSDictionary.class]) {
+    if (error != NULL) *error = jsonError ?: [self riviuMediaError:@"media manifest must be a JSON object"];
+    return nil;
+  }
+  NSDictionary *manifest = (NSDictionary *)decoded;
+  if (![manifest[@"campaignId"] isEqual:campaignId] || [manifest[@"schemaVersion"] integerValue] != 1) {
+    if (error != NULL) *error = [self riviuMediaError:@"media manifest identity is invalid"];
+    return nil;
+  }
+  NSArray *files = manifest[@"files"];
+  if (![files isKindOfClass:NSArray.class] || files.count == 0) {
+    if (error != NULL) *error = [self riviuMediaError:@"media manifest contains no files"];
+    return nil;
+  }
+  NSMutableSet<NSString *> *seen = [NSMutableSet setWithCapacity:files.count];
+  for (id item in files) {
+    if (![item isKindOfClass:NSDictionary.class]) {
+      if (error != NULL) *error = [self riviuMediaError:@"media manifest file entry is invalid"];
+      return nil;
+    }
+    NSDictionary *entry = (NSDictionary *)item;
+    NSString *bundle = entry[@"bundle"];
+    NSString *file = entry[@"file"];
+    NSString *sha256 = entry[@"sha256"];
+    NSNumber *byteCount = entry[@"bytes"];
+    if (![self riviuMediaSafeComponent:bundle] || ![self riviuMediaSafeComponent:file] ||
+        ![self riviuMediaSha256:sha256] || ![byteCount isKindOfClass:NSNumber.class] || byteCount.longLongValue < 0) {
+      if (error != NULL) *error = [self riviuMediaError:@"media manifest file entry schema is invalid"];
+      return nil;
+    }
+    NSString *key = [NSString stringWithFormat:@"%@/%@", bundle, file];
+    if ([seen containsObject:key]) {
+      if (error != NULL) *error = [self riviuMediaError:@"media manifest contains duplicate files"];
+      return nil;
+    }
+    [seen addObject:key];
+    NSString *rootWithSlash = [root stringByAppendingString:@"/"];
+    NSString *filePath = [[root stringByAppendingPathComponent:bundle] stringByAppendingPathComponent:file];
+    if (![filePath.stringByStandardizingPath hasPrefix:rootWithSlash]) {
+      if (error != NULL) *error = [self riviuMediaError:@"media manifest path escapes campaign root"];
+      return nil;
+    }
+    NSData *fileData = [NSData dataWithContentsOfFile:filePath options:NSDataReadingMappedIfSafe error:error];
+    if (fileData == nil || fileData.length != byteCount.unsignedLongLongValue ||
+        ![[self riviuMediaSha256Hex:fileData] isEqualToString:sha256]) {
+      if (error != NULL && *error == nil) *error = [self riviuMediaError:@"media file readback verification failed"];
+      return nil;
+    }
+  }
+  return files;
+}
