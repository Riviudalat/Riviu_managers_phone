+  XCTAssertFalse(FBRiviuRequestIsAuthenticationExempt(@"POST", @"/status"));
+  XCTAssertFalse(FBRiviuRequestIsAuthenticationExempt(@"GET", @"/session/status"));
+  XCTAssertFalse(FBRiviuRequestIsAuthenticationExempt(@"GET", @"/riviu/health"));
+}
+
+- (void)testRiviuAuthenticationTruthTable
+{
+  NSData *expected = [@"test-token" dataUsingEncoding:NSUTF8StringEncoding];
+  XCTAssertTrue(FBRiviuRequestIsAuthorized(@"GET", @"/status", nil, expected));
+  XCTAssertFalse(FBRiviuRequestIsAuthorized(@"GET", @"/riviu/health", nil, expected));
+  XCTAssertFalse(FBRiviuRequestIsAuthorized(@"GET", @"/riviu/health", @"fail-token", expected));
+  XCTAssertFalse(FBRiviuRequestIsAuthorized(@"GET", @"/riviu/health", @"short", expected));
+  XCTAssertTrue(FBRiviuRequestIsAuthorized(@"GET", @"/riviu/health", @"test-token", expected));
