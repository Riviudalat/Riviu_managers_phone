+- (NSObject<HTTPResponse> *)httpResponseForMethod:(NSString *)method URI:(NSString *)path
+{
+  NSString *requestPath = request.url.path ?: path;
+  NSString *providedToken = [request headerField:FBRiviuAgentTokenHeaderName];
+  if (!FBRiviuRequestIsAuthorized(method, requestPath, providedToken, FBRiviuAgentTokenData)) {
+    NSData *body = [@"{\"value\":{\"error\":\"unauthorized\",\"message\":\"Authentication required\",\"stacktrace\":\"\"}}"
+                    dataUsingEncoding:NSUTF8StringEncoding];
+    return [[FBRiviuUnauthorizedResponse alloc] initWithData:body];
+  }
+  return [super httpResponseForMethod:method URI:path];
+}
