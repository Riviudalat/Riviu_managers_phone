+NSString *const FBRiviuAgentTokenEnvironmentName = @"RIVIU_AGENT_TOKEN";
+NSString *const FBRiviuAgentTokenHeaderName = @"X-Riviu-Token";
+
+static NSData *FBRiviuAgentTokenData;
+
+NSData *FBRiviuRequireAgentToken(NSDictionary<NSString *, id> *environment)
+{
+  id rawToken = environment[FBRiviuAgentTokenEnvironmentName];
+  if (![rawToken isKindOfClass:NSString.class] ||
+      [(NSString *)rawToken stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].length == 0) {
+    @throw [NSException exceptionWithName:NSInternalInconsistencyException
+                                   reason:@"RIVIU_AGENT_TOKEN must be set before the control server starts"
+                                 userInfo:nil];
+  }
+  NSData *tokenData = [(NSString *)rawToken dataUsingEncoding:NSUTF8StringEncoding];
+  if (tokenData.length < 32) {
+    @throw [NSException exceptionWithName:NSInternalInconsistencyException
+                                   reason:@"RIVIU_AGENT_TOKEN must contain at least 256 bits"
+                                 userInfo:nil];
+  }
+  return tokenData;
+}
+
+BOOL FBRiviuConstantTimeDataEqual(NSData *expected, NSData *provided)
+{
+  const NSUInteger expectedLength = expected.length;
+  const NSUInteger providedLength = provided.length;
+  const uint8_t *expectedBytes = expected.bytes;
+  const uint8_t *providedBytes = provided.bytes;
+  NSUInteger difference = expectedLength ^ providedLength;
+  for (NSUInteger index = 0; index < expectedLength; index++) {
+    const uint8_t providedByte = index < providedLength ? providedBytes[index] : 0;
+    difference |= expectedBytes[index] ^ providedByte;
+  }
+  return difference == 0;
+}
+
+BOOL FBRiviuRequestIsAuthenticationExempt(NSString *method, NSString *path)
+{
+  return [method isEqualToString:@"GET"] && [path isEqualToString:@"/status"];
+}
+
+BOOL FBRiviuRequestIsAuthorized(NSString *method,
+                                NSString *path,
+                                NSString * _Nullable providedToken,
+                                NSData *expectedToken)
+{
+  if (FBRiviuRequestIsAuthenticationExempt(method, path)) {
+    return YES;
+  }
+  NSData *providedData = [providedToken dataUsingEncoding:NSUTF8StringEncoding] ?: NSData.data;
+  return FBRiviuConstantTimeDataEqual(expectedToken, providedData);
+}
+
+@interface FBRiviuUnauthorizedResponse : HTTPDataResponse
+@end
+
+@implementation FBRiviuUnauthorizedResponse
+
+- (NSInteger)status
+{
+  return 401;
+}
+
+- (NSDictionary *)httpHeaders
+{
+  return @{
+    @"Content-Type": @"application/json; charset=utf-8",
+    @"Connection": @"close",
+  };
+}
+
+@end
 
