++ (BOOL)riviuMediaTapPoint:(CGPoint)point error:(NSError **)error
+{
+  XCPointerEventPath *eventPath = [[XCPointerEventPath alloc]
+                                   initForTouchAtPoint:point
+                                   offset:0.0];
+  [eventPath liftUpAtOffset:0.05];
+  XCSynthesizedEventRecord *eventRecord = [[XCSynthesizedEventRecord alloc]
+                                           initWithName:@"Riviu media confirmation"
+                                           interfaceOrientation:self.riviuMediaInterfaceOrientation];
+  [eventRecord addPointerEventPath:eventPath];
+  return [FBXCTestDaemonsProxy synthesizeEventWithRecord:eventRecord timeout:5.0 error:error];
+}
