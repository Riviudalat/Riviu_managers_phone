++ (BOOL)riviuPasteboardArguments:(id)arguments validForSet:(BOOL)isSet
+{
+  if (![arguments isKindOfClass:NSDictionary.class]) {
+    return NO;
+  }
+  NSDictionary *body = (NSDictionary *)arguments;
+  NSSet<NSString *> *allowedKeys = isSet
+    ? [NSSet setWithArray:@[@"content", @"contentType"]]
+    : [NSSet setWithObject:@"contentType"];
+  if (![[NSSet setWithArray:body.allKeys] isSubsetOfSet:allowedKeys]) {
+    return NO;
+  }
+  id contentType = body[@"contentType"];
+  if (nil != contentType &&
+      (![contentType isKindOfClass:NSString.class] || [(NSString *)contentType length] == 0)) {
+    return NO;
+  }
+  if (!isSet) {
+    return YES;
+  }
+  id encodedContent = body[@"content"];
+  if (![encodedContent isKindOfClass:NSString.class]) {
+    return NO;
+  }
+  return nil != [[NSData alloc] initWithBase64EncodedString:(NSString *)encodedContent
+                                                    options:NSDataBase64DecodingIgnoreUnknownCharacters];
+}
