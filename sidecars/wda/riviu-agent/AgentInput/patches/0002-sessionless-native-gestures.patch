+- (void)testRiviuNativeInputNumberValidation
+{
+  double result = 0.0;
+  XCTAssertTrue([FBElementCommands riviuReadFiniteNumber:@12.5 result:&result]);
+  XCTAssertEqualWithAccuracy(result, 12.5, 0.000001);
+  XCTAssertFalse([FBElementCommands riviuReadFiniteNumber:@YES result:&result]);
+  XCTAssertFalse([FBElementCommands riviuReadFiniteNumber:@"12.5" result:&result]);
+  XCTAssertFalse([FBElementCommands riviuReadFiniteNumber:@(NAN) result:&result]);
+  XCTAssertFalse([FBElementCommands riviuReadFiniteNumber:@(INFINITY) result:&result]);
+}
