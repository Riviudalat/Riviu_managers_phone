+    if ([route.path isEqualToString:@"/wda/tap"] || [route.path isEqualToString:@"/wda/swipe"]) {
+      routes[route.path] = route;
+    }
+  }
+  XCTAssertEqual(routes.count, 2);
+  XCTAssertEqualObjects([routes[@"/wda/tap"] valueForKey:@"requiresSession"], @NO);
+  XCTAssertEqualObjects([routes[@"/wda/swipe"] valueForKey:@"requiresSession"], @NO);
+  XCTAssertEqualObjects(NSStringFromSelector((SEL)[[routes[@"/wda/tap"] valueForKey:@"action"] pointerValue]),
+                        @"handleRiviuNativeTap:");
+  XCTAssertEqualObjects(NSStringFromSelector((SEL)[[routes[@"/wda/swipe"] valueForKey:@"action"] pointerValue]),
