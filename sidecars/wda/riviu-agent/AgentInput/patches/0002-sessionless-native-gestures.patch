+                          timeout:(NSTimeInterval)timeout
+                            error:(NSError *__autoreleasing*)error
+{
+  __block volatile atomic_bool didFinish = false;
+  __block BOOL eventSucceeded = NO;
+  __block NSError *innerError = nil;
+  [[XCUIDevice.sharedDevice eventSynthesizer]
+   synthesizeEvent:record
+   completion:(id)^(BOOL result, NSError *invokeError) {
+    eventSucceeded = result;
+    innerError = invokeError;
+    atomic_store(&didFinish, true);
   }];
+
+  NSError *timeoutError = nil;
+  BOOL completed = [[[[FBRunLoopSpinner new]
+                      timeout:timeout]
+                     timeoutErrorMessage:@"Event synthesis timed out"]
+                    spinUntilTrue:^BOOL{
+    return atomic_load(&didFinish);
+  } error:&timeoutError];
+  if (!completed) {
+    return [[[[FBErrorBuilder builder]
+              withDescription:@"Event synthesis timed out"]
+             withInnerError:timeoutError]
+            buildError:error];
+  }
   if (nil != innerError) {
     if (error) {
       *error = innerError;
     }
     return NO;
   }
+  if (!eventSucceeded) {
+    return [[[FBErrorBuilder builder]
+             withDescription:@"Event synthesis returned an unsuccessful result"]
+            buildError:error];
+  }
   return YES;
 }
 
