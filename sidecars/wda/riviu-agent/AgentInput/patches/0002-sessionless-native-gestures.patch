++ (BOOL)riviuReadFiniteNumber:(id)candidate result:(double *)result
+{
+  if (![candidate isKindOfClass:NSNumber.class] ||
+      CFGetTypeID((__bridge CFTypeRef)candidate) == CFBooleanGetTypeID()) {
+    return NO;
+  }
+  double value = [candidate doubleValue];
+  if (!isfinite(value)) {
+    return NO;
+  }
+  if (nil != result) {
+    *result = value;
+  }
+  return YES;
+}
+
++ (BOOL)riviuArguments:(NSDictionary<NSString *, id> *)arguments
+     containExactlyKeys:(NSArray<NSString *> *)keys
+{
+  if (![arguments isKindOfClass:NSDictionary.class]) {
+    return NO;
+  }
+  return [[NSSet setWithArray:arguments.allKeys] isEqualToSet:[NSSet setWithArray:keys]];
+}
+
++ (id<FBResponsePayload>)riviuInvalidNativeInput:(NSString *)message
+{
+  return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:message traceback:nil]);
+}
+
++ (UIInterfaceOrientation)riviuInterfaceOrientation
+{
+  switch (XCUIDevice.sharedDevice.orientation) {
+    case UIDeviceOrientationPortrait:
+      return UIInterfaceOrientationPortrait;
+    case UIDeviceOrientationPortraitUpsideDown:
+      return UIInterfaceOrientationPortraitUpsideDown;
+    case UIDeviceOrientationLandscapeLeft:
+      return UIInterfaceOrientationLandscapeRight;
+    case UIDeviceOrientationLandscapeRight:
+      return UIInterfaceOrientationLandscapeLeft;
+    case UIDeviceOrientationUnknown:
+    case UIDeviceOrientationFaceUp:
+    case UIDeviceOrientationFaceDown:
+    default:
+      return UIInterfaceOrientationPortrait;
+  }
+}
+
++ (id<FBResponsePayload>)handleRiviuNativeTap:(FBRouteRequest *)request
+{
+  double x;
+  double y;
+  if (![self riviuArguments:request.arguments containExactlyKeys:@[@"x", @"y"]] ||
+      ![self riviuReadFiniteNumber:request.arguments[@"x"] result:&x] ||
+      ![self riviuReadFiniteNumber:request.arguments[@"y"] result:&y]) {
+    return [self riviuInvalidNativeInput:@"Tap requires exactly finite numeric x and y arguments"];
+  }
+
+  XCPointerEventPath *eventPath = [[XCPointerEventPath alloc]
+                                   initForTouchAtPoint:CGPointMake((CGFloat)x, (CGFloat)y)
+                                   offset:0.0];
+  [eventPath liftUpAtOffset:0.05];
+  XCSynthesizedEventRecord *eventRecord = [[XCSynthesizedEventRecord alloc]
+                                           initWithName:@"Riviu native tap"
+                                           interfaceOrientation:self.riviuInterfaceOrientation];
+  [eventRecord addPointerEventPath:eventPath];
+  NSError *error = nil;
+  if (![FBXCTestDaemonsProxy synthesizeEventWithRecord:eventRecord timeout:5.0 error:&error]) {
+    NSString *message = error.localizedDescription ?: @"Native tap synthesis failed";
+    return FBResponseWithStatus([FBCommandStatus invalidElementStateErrorWithMessage:message
+                                                                           traceback:nil]);
+  }
+  return FBResponseWithOK();
+}
+
++ (id<FBResponsePayload>)handleRiviuNativeSwipe:(FBRouteRequest *)request
+{
+  NSArray<NSString *> *keys = @[@"fromX", @"fromY", @"toX", @"toY", @"delay"];
+  double fromX;
+  double fromY;
+  double toX;
+  double toY;
+  double delay;
+  if (![self riviuArguments:request.arguments containExactlyKeys:keys] ||
+      ![self riviuReadFiniteNumber:request.arguments[@"fromX"] result:&fromX] ||
+      ![self riviuReadFiniteNumber:request.arguments[@"fromY"] result:&fromY] ||
+      ![self riviuReadFiniteNumber:request.arguments[@"toX"] result:&toX] ||
+      ![self riviuReadFiniteNumber:request.arguments[@"toY"] result:&toY] ||
+      ![self riviuReadFiniteNumber:request.arguments[@"delay"] result:&delay] ||
+      delay < 0.0 || delay > 5.0) {
+    return [self riviuInvalidNativeInput:@"Swipe requires finite from/to coordinates and delay in [0, 5]"];
+  }
+
+  XCPointerEventPath *eventPath = [[XCPointerEventPath alloc]
+                                   initForTouchAtPoint:CGPointMake((CGFloat)fromX, (CGFloat)fromY)
+                                   offset:0.0];
+  [eventPath moveToPoint:CGPointMake((CGFloat)toX, (CGFloat)toY) atOffset:delay];
+  [eventPath liftUpAtOffset:delay];
+  XCSynthesizedEventRecord *eventRecord = [[XCSynthesizedEventRecord alloc]
+                                           initWithName:@"Riviu native swipe"
+                                           interfaceOrientation:self.riviuInterfaceOrientation];
+  [eventRecord addPointerEventPath:eventPath];
+  NSError *error = nil;
+  if (![FBXCTestDaemonsProxy synthesizeEventWithRecord:eventRecord timeout:5.0 error:&error]) {
+    NSString *message = error.localizedDescription ?: @"Native swipe synthesis failed";
+    return FBResponseWithStatus([FBCommandStatus invalidElementStateErrorWithMessage:message
+                                                                           traceback:nil]);
+  }
+  return FBResponseWithOK();
+}
